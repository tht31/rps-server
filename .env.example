# === DATABASE ===
DATABASE_URL=postgresql://rps_user:rps_pass@localhost:5432/rps_arena
DB_HOST=localhost
DB_PORT=5432
DB_NAME=rps_arena
DB_USER=rps_user
DB_PASS=rps_pass

# === REDIS ===
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# === AUTH ===
JWT_SECRET=change_me_in_production_use_random_64char
JWT_EXPIRES_IN=7d

# === SERVER ===
PORT=4000
NODE_ENV=development

# === BOT STORAGE ===
# Thu muc luu tru file .py cua cac doi
BOT_STORAGE_PATH=./storage/bots

# === SANDBOX ===
# Python interpreter de chay bot
PYTHON_BIN=python3
# Timeout (ms) cho moi luot di
MOVE_TIMEOUT_MS=100
# So luot moi tran
MATCH_ROUNDS=50
