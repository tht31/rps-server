# ============================================================
# RPS Arena - Git Ignore Rules
# ============================================================

# --- 1. Dependencies ---
node_modules/
*/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- 2. Sensitive Environment & Credentials ---
.env
.env.local
.env.*.local
*.pem
*.key
*.cert

# --- 3. Build & Compilation Artifacts ---
dist/
build/
*/dist/
*/build/
*.tsbuildinfo

# --- 4. Runtime & Dynamic Upload Storage ---
# (Chứa bot của các đội thi & logs replay trận đấu)
storage/
*/storage/
logs/
*/logs/
*.log

# --- 5. Python Artifacts & Sandbox Cache ---
__pycache__/
*/__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo
.pytest_cache/
.coverage

# --- 6. Editor & Operating System Files ---
.vscode/
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# --- 7. Scratch & Temporary Files ---
test.txt
tmp/
temp/
